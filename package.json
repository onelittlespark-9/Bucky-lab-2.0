{
  "name": "bucky-lab-2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-browser-case.mjs && vite",
    "typecheck": "tsc --noEmit",
    "validate:ct": "node scripts/validate-regional-assets.mjs",
    "build": "node scripts/generate-browser-case.mjs && npm run validate:ct && npm run typecheck && vite build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.132.0"
  }
}
