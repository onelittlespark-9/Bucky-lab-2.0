{
  "name": "bucky-lab-2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-browser-case.mjs && vite",
    "typecheck": "tsc --noEmit",
    "validate:ct": "node scripts/validate-regional-assets.mjs",
    "build": "node scripts/generate-browser-case.mjs && npm run validate:patient && npm run validate:ct && npm run validate:drr && npm run typecheck && vite build",
    "deploy": "npm run build && wrangler deploy",
    "render:drr": "node --import tsx scripts/render-drr-reference.ts",
    "validate:patient": "node scripts/validate-articulated-patient.mjs",
    "validate:drr": "node --import tsx scripts/validate-drr-geometry.ts"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.132.0"
  }
}
